<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="screenshoton.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Wareon\ScreenShotOn">
    </Installer>
    <PackageInformation
        PackageName="ScreenShotOn"
        PackageDisplayName="ScreenShotOn"
        PublisherName="CN=Wareon"
        PublisherDisplayName="Wareon"
        Version="0.1.0.0"
        PackageDescription="A ScreenShotOn application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.wareon.screenshoton"
                Description="A ScreenShotOn application"
                DisplayName="ScreenShotOn"
                ExecutableName="screenshoton.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ScreenShotOn</DisplayName>
            <PublisherDisplayName>Wareon</PublisherDisplayName>
            <Description>A ScreenShotOn application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="screenshoton.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
